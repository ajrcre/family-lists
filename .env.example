# Copy to .env.local for local development, and set the same variables in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# Postgres connection string. On Vercel, adding a Neon database from the
# Marketplace sets this automatically. Leave empty locally to use a built-in
# file database (PGlite) under ./.data — local development only.
DATABASE_URL=

# Bearer token for the JSON API (Authorization: Bearer <token>). Generate with:
#   npm run gen-secret
API_TOKEN=replace-with-a-long-random-token

# scrypt hash of the 4-digit web PIN (never the PIN itself). Generate with:
#   npm run hash-pin -- 1234
PIN_HASH=scrypt:16384:8:1:replace-with-salt:replace-with-hash

# Signs web-session cookies (32+ characters). Generate with: npm run gen-secret
# Changing it signs everyone out.
SESSION_SECRET=replace-with-a-long-random-secret

# Signs shareable access links (32+ characters). Generate with: npm run gen-secret
# Changing it revokes every access link and every session opened from one.
ACCESS_LINK_SECRET=replace-with-another-long-random-secret

# Optional: public base URL used when generating access links,
# e.g. https://your-app.vercel.app. Defaults to the request's origin.
APP_URL=
